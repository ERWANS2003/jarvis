# Copie ce fichier en ".env" et renseigne tes cles API.
# Le fichier ".env" est ignore par git : tes cles ne sont jamais versionnees.

# --- Fournisseur (compatible API OpenAI : OpenAI, OpenRouter, Ollama, LM Studio) ---
JARVIS_BASE_URL=https://openrouter.ai/api/v1
# Meilleur modele gratuit OpenRouter teste (rapide, outils, bon francais, images).
JARVIS_MODEL=nvidia/nemotron-3.5-super-vl:free

# Replis automatiques : uniquement des modeles GRATUITS du meme fournisseur
# (meme cle, meme URL), essayes dans l'ordre si le principal echoue. Sans cette
# ligne, Jarvis utilise la liste gratuite integree. Separes par des virgules.
# JARVIS_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# Une seule cle est necessaire. Celle de JARVIS_BASE_URL est utilisee en priorite.
OPENROUTER_API_KEY=your_openrouter_key_here

# Groq (FACULTATIF, gratuit) : reponses en ~1 s au lieu de 4 a 8 s.
# Cle sur https://console.groq.com/keys ; Groq passe alors en tete et
# OpenRouter sert de repli. JARVIS_GROQ=0 le desactive.
# GROQ_API_KEY=gsk_...
# JARVIS_GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_key_here

# --- Optionnels ---
# Toutes ces variables sont FACULTATIVES : elles ne servent qu'a eviter de
# repeter les memes options a chaque lancement. La ligne de commande reste
# prioritaire. Un fichier jarvis.yaml (voir jarvis.example.yaml) fait la meme
# chose de maniere plus lisible.

# Langue de l'interface vocale : en (defaut) ou fr
# JARVIS_LANG=fr

# Voix, volume (0..1) et debit de lecture (mots/minute)
# JARVIS_VOICE=TTS_MS_FR-FR_HORTENSE_11.0
# JARVIS_VOLUME=1.0
# JARVIS_RATE=190

# Role donne a l'assistant
# JARVIS_ABILITY=general knowledge

# Memoire longue duree (Horizon 2)
# JARVIS_MEMORY_PATH=.jarvis_memory.db
# JARVIS_HISTORY_PATH=.jarvis_history.json

# Reconnaissance vocale (Horizon 4) : auto | google | whisper | local
# JARVIS_STT=auto

# Voix Piper (modele:locuteur, dans voices/ ; voir install.ps1 -Optional)
# JARVIS_PIPER_VOICE=fr_FR-upmc-medium:jessica
# JARVIS_WHISPER_MODEL=base

# Repli hors-ligne via Ollama (Horizon 4)
# JARVIS_LOCAL_MODEL=llama3.2
# JARVIS_LOCAL_BASE_URL=http://localhost:11434/v1

# Plugins (Horizon 6)
# JARVIS_PLUGINS_DIR=plugins

# Tout le reste (mot d'activation, interruption, duree max d'une reponse...) :
#   python jarvis.py --help
